{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "key_data.schema.json",
  "title": "KeyDataGroup",
  "description": "A key_data observation group. references/00-contracts.md §5. First route by metric_family + normalized metric_name, then compare the five grouping_key keys. The group keeps all source observations while the group itself carries the merge conclusion. Silent overwriting is forbidden.",

  "type": "object",
  "required": ["id", "metric_name", "metric_family", "grouping_key", "status",
               "canonical_observation", "observations", "compatible_observations",
               "conflicting_observations", "reporting_completeness", "missing_elements"],
  "additionalProperties": false,

  "properties": {
    "id": {"type": "string", "pattern": "^KD-[0-9]{3,}$"},
    "metric_name": {"type": "string", "minLength": 1,
                    "description": "e.g. IC50 / tumor volume / sensitivity"},
    "metric_family": {"$ref": "common.schema.json#/$defs/metric_family"},

    "grouping_key": {
      "type": "object",
      "description": "Once metric_family and the normalized metric_name already match, it is the same group only when all five keys are equal. null equals null; null on one side and a value on the other counts as unequal. A mismatched metric identity or key means two groups, not a conflict.",
      "required": ["experiment_id", "group", "comparison", "timepoint", "endpoint"],
      "additionalProperties": false,
      "properties": {
        "experiment_id": {"type": ["string", "null"]},
        "group": {"type": ["string", "null"]},
        "comparison": {"type": ["string", "null"]},
        "timepoint": {"type": ["string", "null"]},
        "endpoint": {"type": ["string", "null"]}
      }
    },

    "status": {
      "enum": ["reported", "compatible_multiple_sources", "conflicting", "ambiguous",
               "pending_visual_resolution", "parse_failed"],
      "description": "pending_visual_resolution is only allowed to appear in structured_result_v1"
    },

    "canonical_observation": {
      "type": ["string", "null"],
      "description": "An observation_id, or null. Must be null when status is conflicting/ambiguous/pending_visual_resolution/parse_failed."
    },

    "canonical_rationale": {
      "type": ["string", "null"],
      "description": "The matched criterion number and rationale, e.g. 'criterion_2: fig:2C carries a 95% CI'. Required when a canonical is chosen."
    },

    "observations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/observation"},
      "description": "All source observations are kept without exception; deletion or overwriting is forbidden. Stage 3b removes only the Figure Parser's three temporary routing fields, and all other observation_core fields must be preserved verbatim; cross-copy uniqueness and content consistency of observation_id are checked by the contract validator."
    },

    "compatible_observations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"},
      "description": "observation_ids judged compatible"
    },

    "conflicting_observations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"},
      "description": "observation_ids judged incompatible (both sides of the conflict are listed)"
    },

    "reporting_completeness": {"$ref": "common.schema.json#/$defs/reporting_completeness"},

    "missing_elements": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Elements this metric_family requires that the manuscript did not report, e.g. [\"dispersion\", \"n\"]"
    },

    "signal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SIG-[0-9]{3,}$"}
    },

    "resolution_state": {
      "type": ["object", "null"],
      "description": "Non-null only when status = pending_visual_resolution",
      "required": ["state", "pending_stage", "expected_sources"],
      "additionalProperties": false,
      "properties": {
        "state": {"const": "pending_visual_resolution"},
        "pending_stage": {"const": "stage_3"},
        "expected_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },

    "system_limitation_ref": {
      "type": ["string", "null"],
      "pattern": "^SYS-[0-9]{3,}$",
      "description": "Required when status = parse_failed, pointing to the corresponding system_limitation"
    }
  },

  "allOf": [
    {
      "description": "Must be null when no defensible canonical exists",
      "if": {
        "properties": {
          "status": {"enum": ["conflicting", "ambiguous", "pending_visual_resolution", "parse_failed"]}
        },
        "required": ["status"]
      },
      "then": {"properties": {"canonical_observation": {"type": "null"}}}
    },
    {
      "description": "Choosing a canonical requires a stated rationale",
      "if": {
        "properties": {"canonical_observation": {"type": "string"}},
        "required": ["canonical_observation"]
      },
      "then": {"required": ["canonical_rationale"],
               "properties": {"canonical_rationale": {"type": "string", "minLength": 1}}}
    },
    {
      "description": "When canonical is null, completeness is always not_assessed",
      "if": {
        "properties": {"canonical_observation": {"type": "null"}},
        "required": ["canonical_observation"]
      },
      "then": {"properties": {
        "canonical_rationale": {"type": "null"},
        "reporting_completeness": {"const": "not_assessed"},
        "missing_elements": {"maxItems": 0}
      }}
    },
    {
      "description": "reported means exactly one source, and that source must be selected",
      "if": {"properties": {"status": {"const": "reported"}}, "required": ["status"]},
      "then": {"properties": {
        "observations": {"minItems": 1, "maxItems": 1},
        "canonical_observation": {"type": "string"},
        "compatible_observations": {"maxItems": 0},
        "conflicting_observations": {"maxItems": 0}
      }}
    },
    {
      "description": "compatible_multiple_sources requires at least two items, a chosen canonical, and no registered conflicts",
      "if": {"properties": {"status": {"const": "compatible_multiple_sources"}},
             "required": ["status"]},
      "then": {"properties": {
        "observations": {"minItems": 2},
        "canonical_observation": {"type": "string"},
        "compatible_observations": {"minItems": 2},
        "conflicting_observations": {"maxItems": 0}
      }}
    },
    {
      "description": "conflicting requires the conflicting observations to be registered",
      "if": {"properties": {"status": {"const": "conflicting"}}, "required": ["status"]},
      "then": {"properties": {
        "observations": {"minItems": 2},
        "conflicting_observations": {"minItems": 2}
      }}
    },
    {
      "description": "The pending status must carry a resolution_state",
      "if": {"properties": {"status": {"const": "pending_visual_resolution"}}, "required": ["status"]},
      "then": {"required": ["resolution_state"],
               "properties": {
                 "observations": {"maxItems": 0},
                 "resolution_state": {"type": "object"}
               }}
    },
    {
      "description": "parse_failed has no usable observations yet and must link a system limitation",
      "if": {"properties": {"status": {"const": "parse_failed"}}, "required": ["status"]},
      "then": {"required": ["system_limitation_ref"],
               "properties": {
                 "observations": {"maxItems": 0},
                 "system_limitation_ref": {"type": "string"}
               }}
    },
    {
      "description": "resolution_state must not linger outside pending",
      "if": {"properties": {"status": {"not": {"const": "pending_visual_resolution"}}},
             "required": ["status"]},
      "then": {"properties": {"resolution_state": {"type": "null"}}}
    },
    {
      "description": "A system_limitation may only be linked under parse_failed",
      "if": {"properties": {"status": {"not": {"const": "parse_failed"}}},
             "required": ["status"]},
      "then": {"properties": {"system_limitation_ref": {"type": "null"}}}
    }
  ],

  "$defs": {

    "observation": {
      "allOf": [{"$ref": "#/$defs/observation_core"}],
      "unevaluatedProperties": false,
      "description": "A single source observation inside key_data; carrying the Figure Parser's temporary routing fields is forbidden."
    },

    "observation_core": {
      "type": "object",
      "description": "The composable observation core. 00-contracts.md §5.2. figure_record adds Stage 3b routing fields on top of this core; when stored directly in key_data, observation seals off extra properties.",
      "required": ["observation_id", "value", "unit", "unit_normalized", "uncertainty",
                   "n", "replicate_type", "provenance", "extraction_confidence",
                   "manual_review_needed"],
      "properties": {
        "observation_id": {"type": "string", "pattern": "^OBS-[0-9]{3,}$"},
        "value": {"$ref": "common.schema.json#/$defs/numeric_value"},
        "unit": {"type": ["string", "null"], "description": "The manuscript's original wording"},
        "unit_normalized": {"type": ["string", "null"], "description": "The ucum_code returned by the normalizer, for audit trail only; value stays in the original unit and factor_a_to_b must be applied before comparison"},
        "uncertainty": {"$ref": "common.schema.json#/$defs/uncertainty"},
        "n": {"type": ["integer", "null"], "minimum": 1},
        "replicate_type": {"oneOf": [{"$ref": "common.schema.json#/$defs/replicate_type"}, {"type": "null"}]},
        "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
        "extraction_confidence": {"$ref": "common.schema.json#/$defs/confidence_level"},
        "manual_review_needed": {"type": "boolean"},
        "quote": {"type": ["string", "null"]}
      },

      "allOf": [
        {
          "description": "00-contracts.md §2.4: the five mandatory pixel_estimated constraints (the interval must also be non-zero width; value ordering, the M4 ban, and the finding confidence cap are enforced by the contract validator)",
          "if": {
            "properties": {"provenance": {"properties": {"source_type": {"const": "pixel_estimated"}},
                                          "required": ["source_type"]}},
            "required": ["provenance"]
          },
          "then": {
            "properties": {
              "value": {"properties": {"type": {"enum": ["interval", "lower_bound", "upper_bound"]}}},
              "extraction_confidence": {"const": "low"},
              "manual_review_needed": {"const": true}
            }
          }
        },
        {
          "description": "axis_readable allows point values, but confidence is capped at medium",
          "if": {
            "properties": {"provenance": {"properties": {"source_type": {"const": "axis_readable"}},
                                          "required": ["source_type"]}},
            "required": ["provenance"]
          },
          "then": {"properties": {"extraction_confidence": {"enum": ["medium", "low"]}}}
        }
      ]
    }
  }
}
