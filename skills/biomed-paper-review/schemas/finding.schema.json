{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "Finding",
  "description": "稿件级审核判断。references/00-contracts.md §6.1。仅 M2–M7 可产出 —— M1 是前置抽取层，不得产出 finding。任何不符合本模式的输出视为无效并丢弃。",

  "type": "object",
  "required": ["id", "module", "category", "severity", "title", "detail",
               "evidence_refs", "review_confidence", "manual_review"],
  "additionalProperties": false,

  "properties": {
    "id": {
      "type": "string",
      "pattern": "^M[2-7]-[0-9]{3}$",
      "description": "模块前缀 + 三位序号，如 M4-003。M1- 前缀非法。"
    },

    "module": {
      "$ref": "common.schema.json#/$defs/module_id_review",
      "description": "M1 非法 —— 抽取层的观察走 extraction_signal 或 coverage_breakdown"
    },

    "category": {
      "type": "string",
      "description": "该模块 reference 文件中已登记的 slug，不得自创"
    },

    "severity": {
      "enum": ["critical", "major", "minor", "info"],
      "description": "critical=结论不成立/伦理违规/疑似不端; major=需作者补材料或重做分析; minor=表述与规范问题; info=提示"
    },

    "title": {"type": "string", "maxLength": 80},
    "detail": {"type": "string", "minLength": 1},

    "evidence_refs": {
      "allOf": [
        {"$ref": "evidence.schema.json#/$defs/evidence_refs"},
        {"minItems": 1}
      ],
      "description": "必须非空，且每项在 evidence_registry 中解析到恰好一个条目。canonical 存储形式，禁止内联 evidence[] 对象数组。"
    },

    "rule_ref": {
      "type": "string",
      "description": "触发本发现的规则锚点，如 04-statistics#sample-size-reporting"
    },

    "review_confidence": {
      "$ref": "common.schema.json#/$defs/confidence_level",
      "description": "本条判断本身的可靠程度。证据含 pixel_estimated 或指向 ambiguous 字段时上限为 medium。"
    },

    "derived_from_signals": {
      "type": "array",
      "items": {"type": "string", "pattern": "^SIG-[0-9]{3,}$"},
      "description": "溯源用。不得替代 evidence_refs —— 仅凭 signal id 立 finding 为契约违规。"
    },

    "related_findings": {
      "type": "array",
      "items": {"type": "string"},
      "description": "去重聚簇时被合并到本条之下的其他 finding id"
    },

    "manual_review": {
      "type": "object",
      "required": ["action", "who"],
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string",
          "description": "可执行的复核动作：看哪里、核什么、若属实该补什么"
        },
        "who": {
          "enum": ["statistical_reviewer", "domain_reviewer", "ethics_committee",
                   "editor", "author"],
          "description": "英文枚举；渲染层负责本地化显示"
        },
        "priority": {"enum": ["P0", "P1", "P2"]}
      }
    }
  },

  "allOf": [
    {
      "description": "00-contracts.md §6.1 规则 2：severity >= major 必须有非空可执行动作",
      "if": {"properties": {"severity": {"enum": ["critical", "major"]}}, "required": ["severity"]},
      "then": {
        "properties": {
          "manual_review": {
            "properties": {"action": {"type": "string", "minLength": 1}},
            "required": ["action", "priority"]
          }
        }
      }
    },
    {
      "description": "critical 会阻断审稿结论，人工复核固定为 P0",
      "if": {"properties": {"severity": {"const": "critical"}}, "required": ["severity"]},
      "then": {"properties": {"manual_review": {
        "required": ["priority"],
        "properties": {"priority": {"const": "P0"}}
      }}}
    },
    {
      "description": "minor/info 若进入报告级人工复核计划，只能作为 P2",
      "if": {"properties": {"severity": {"enum": ["minor", "info"]}},
             "required": ["severity"]},
      "then": {"properties": {"manual_review": {
        "properties": {"priority": {"const": "P2"}}
      }}}
    }
  ]
}
